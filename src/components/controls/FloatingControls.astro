---
import type { MarkdownHeading } from "astro";
import FloatingMusicPlayer from "@/components/features/FloatingMusicPlayer.astro";
import { musicPlayerConfig } from "@/config/musicConfig";
import BackToComment from "./BackToComment.astro";
import BackToHome from "./BackToHome.astro";
import BackToTop from "./BackToTop.astro";
import FloatingTOC from "./FloatingTOC.astro";

interface Props {
	headings?: MarkdownHeading[];
	encrypted?: boolean;
}

const { headings, encrypted } = Astro.props;
---

<div class="floating-controls-container">
  <FloatingTOC headings={headings ?? []} encrypted={encrypted} />
  <BackToComment />
  <BackToHome />
  <BackToTop />
  {musicPlayerConfig.showFloatingPlayer !== false && <FloatingMusicPlayer />}
</div>

<style>
  .floating-controls-container {
    position: fixed;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end; /* 右对齐 */
    pointer-events: none; /* 容器不阻挡点击 */
    
    /* 默认桌面端位置 - 对应 BackToTop 的位置 */
    right: 1rem;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
  }

  /* 响应式调整 - 保持原有的位置逻辑 */
  @media (max-width: 1024px) {
    .floating-controls-container {
      right: 1rem;
    }
  }

  @media (max-width: 768px) {
    .floating-controls-container {
      right: 0.75rem;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .floating-controls-container {
      right: 0.5rem;
    }
  }

  /* 高缩放比例适配 */
  @media (min-resolution: 2dppx) {
    .floating-controls-container {
      right: max(0.5rem, 2rem - 2vw);
    }
  }

  /* 极低分辨率适配 */
  @media (max-width: 320px) {
    .floating-controls-container {
        right: 0.125rem;
    }
  }
</style>
