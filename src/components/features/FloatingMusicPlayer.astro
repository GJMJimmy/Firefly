---
import { Icon } from "astro-icon/components";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const config = musicPlayerConfig;
const viewConfigStr = JSON.stringify({
	showLyrics: config.showLyrics ?? true,
	i18n: {
		audioPlayer: i18n(I18nKey.musicAudioPlayer),
		collapse: i18n(I18nKey.collapse),
		error: i18n(I18nKey.musicError),
		failedLyrics: i18n(I18nKey.musicFailedLyrics),
		loadingLyrics: i18n(I18nKey.musicLoadingLyrics),
		lyrics: i18n(I18nKey.musicLyrics),
		next: i18n(I18nKey.musicNext),
		noCover: i18n(I18nKey.musicNoCover),
		noLyrics: i18n(I18nKey.musicNoLyrics),
		noPlaying: i18n(I18nKey.musicNoPlaying),
		noSongs: i18n(I18nKey.musicNoSongs),
		pause: i18n(I18nKey.musicPause),
		play: i18n(I18nKey.musicPlay),
		playlist: i18n(I18nKey.musicPlaylist),
		playMode: i18n(I18nKey.musicPlayMode),
		prev: i18n(I18nKey.musicPrev),
		progress: i18n(I18nKey.musicProgress),
		volume: i18n(I18nKey.musicVolume),
	},
});
---

<div
	id="floating-music-player"
	class="floating-music-player"
	data-view="loading"
	data-drawer="none"
	role="region"
	aria-label={i18n(I18nKey.musicAudioPlayer)}
>
	<button class="floating-entry loading-entry" type="button" disabled aria-label={i18n(I18nKey.musicAudioPlayer)}>
		<Icon is:inline name="material-symbols:sync-rounded" class="entry-icon loading-icon" aria-hidden="true" />
	</button>

	<button class="floating-entry orb-entry" type="button" title={i18n(I18nKey.musicAudioPlayer)} aria-label={i18n(I18nKey.musicAudioPlayer)}>
		<Icon is:inline name="material-symbols:music-note-rounded" class="entry-icon orb-note" aria-hidden="true" />
		<span class="equalizer" aria-hidden="true"><i></i><i></i><i></i></span>
	</button>

	<section class="floating-panel mini-panel" aria-label={i18n(I18nKey.musicAudioPlayer)}>
		<button class="mini-cover cover-button" type="button" title={i18n(I18nKey.musicPlay)} aria-label={i18n(I18nKey.musicPlay)}>
			<span class="cover-fallback"><Icon is:inline name="material-symbols:music-note-rounded" aria-hidden="true" /></span>
			<img class="cover-image" src="" alt={i18n(I18nKey.musicNoCover)} />
			<span class="cover-action" aria-hidden="true">
				<Icon is:inline name="material-symbols:play-arrow-rounded" class="cover-play-icon" />
				<Icon is:inline name="material-symbols:pause-rounded" class="cover-pause-icon" />
			</span>
		</button>

		<button class="mini-metadata expand-button" type="button" title={i18n(I18nKey.musicAudioPlayer)} aria-label={i18n(I18nKey.musicAudioPlayer)}>
			<strong class="track-title">{i18n(I18nKey.musicNoPlaying)}</strong>
			<span class="track-artist">-</span>
		</button>

		<div class="mini-actions">
			<button class="icon-button hide-button" type="button" title={i18n(I18nKey.collapse)} aria-label={i18n(I18nKey.collapse)}>
				<Icon is:inline name="material-symbols:visibility-off-outline-rounded" aria-hidden="true" />
			</button>
			<button class="icon-button expand-button" type="button" title={i18n(I18nKey.musicAudioPlayer)} aria-label={i18n(I18nKey.musicAudioPlayer)}>
				<Icon is:inline name="material-symbols:expand-less-rounded" aria-hidden="true" />
			</button>
		</div>
	</section>

	<section class="floating-panel expanded-panel" aria-label={i18n(I18nKey.musicAudioPlayer)}>
		<div class="expanded-main">
			<header class="expanded-heading">
				<div class="expanded-cover">
					<span class="cover-fallback"><Icon is:inline name="material-symbols:music-note-rounded" aria-hidden="true" /></span>
					<img class="cover-image" src="" alt={i18n(I18nKey.musicNoCover)} />
				</div>
				<div class="expanded-metadata">
					<strong class="track-title">{i18n(I18nKey.musicNoPlaying)}</strong>
					<span class="track-artist">-</span>
				</div>
				<button class="icon-button hide-button" type="button" title={i18n(I18nKey.collapse)} aria-label={i18n(I18nKey.collapse)}>
					<Icon is:inline name="material-symbols:visibility-off-outline-rounded" aria-hidden="true" />
				</button>
			</header>

			<div class="progress-block">
				<div class="progress-times" aria-live="off">
					<span class="current-time">0:00</span>
					<span class="total-time">0:00</span>
				</div>
				<div class="range-control progress-control" role="slider" tabindex="0" aria-label={i18n(I18nKey.musicProgress)} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
					<span class="range-fill progress-fill"></span>
					<span class="range-thumb progress-thumb"></span>
				</div>
			</div>

			<div class="transport-controls">
				<button class="icon-button mode-button" type="button" title={i18n(I18nKey.musicPlayMode)} aria-label={i18n(I18nKey.musicPlayMode)}>
					<Icon is:inline name="material-symbols:repeat-rounded" class="mode-list-icon" aria-hidden="true" />
					<Icon is:inline name="material-symbols:repeat-one-rounded" class="mode-one-icon" aria-hidden="true" />
					<Icon is:inline name="material-symbols:shuffle-rounded" class="mode-random-icon" aria-hidden="true" />
				</button>
				<button class="icon-button prev-button" type="button" title={i18n(I18nKey.musicPrev)} aria-label={i18n(I18nKey.musicPrev)}>
					<Icon is:inline name="material-symbols:skip-previous-rounded" aria-hidden="true" />
				</button>
				<button class="play-button" type="button" title={i18n(I18nKey.musicPlay)} aria-label={i18n(I18nKey.musicPlay)}>
					<Icon is:inline name="material-symbols:play-arrow-rounded" class="play-icon" aria-hidden="true" />
					<Icon is:inline name="material-symbols:pause-rounded" class="pause-icon" aria-hidden="true" />
				</button>
				<button class="icon-button next-button" type="button" title={i18n(I18nKey.musicNext)} aria-label={i18n(I18nKey.musicNext)}>
					<Icon is:inline name="material-symbols:skip-next-rounded" aria-hidden="true" />
				</button>
				<button class="icon-button lyrics-button" type="button" title={i18n(I18nKey.musicLyrics)} aria-label={i18n(I18nKey.musicLyrics)} aria-pressed="false" hidden={!config.showLyrics}>
					<Icon is:inline name="material-symbols:subtitles-outline-rounded" aria-hidden="true" />
				</button>
			</div>

			<div class="secondary-controls">
				<button class="icon-button mute-button" type="button" title={i18n(I18nKey.musicVolume)} aria-label={i18n(I18nKey.musicVolume)}>
					<Icon is:inline name="material-symbols:volume-up-rounded" class="volume-icon" aria-hidden="true" />
					<Icon is:inline name="material-symbols:volume-off-rounded" class="muted-icon" aria-hidden="true" />
				</button>
				<div class="range-control volume-control" role="slider" tabindex="0" aria-label={i18n(I18nKey.musicVolume)} aria-valuemin="0" aria-valuemax="100" aria-valuenow="70">
					<span class="range-fill volume-fill"></span>
					<span class="range-thumb volume-thumb"></span>
				</div>
				<button class="icon-button playlist-button" type="button" title={i18n(I18nKey.musicPlaylist)} aria-label={i18n(I18nKey.musicPlaylist)} aria-pressed="false">
					<Icon is:inline name="material-symbols:queue-music-rounded" aria-hidden="true" />
				</button>
				<button class="icon-button collapse-button" type="button" title={i18n(I18nKey.collapse)} aria-label={i18n(I18nKey.collapse)}>
					<Icon is:inline name="material-symbols:expand-more-rounded" aria-hidden="true" />
				</button>
			</div>
		</div>

		<div class="drawer lyrics-drawer" aria-label={i18n(I18nKey.musicLyrics)}>
			<div class="lyrics-container custom-scrollbar" role="listbox">
				<p class="drawer-status">{i18n(I18nKey.musicNoLyrics)}</p>
			</div>
		</div>

		<div class="drawer playlist-drawer" aria-label={i18n(I18nKey.musicPlaylist)}>
			<div class="playlist-container custom-scrollbar" role="listbox"></div>
		</div>
	</section>
</div>

<script is:inline define:vars={{ viewConfigStr }}>
(() => {
	var cfg = JSON.parse(viewConfigStr);
	var root = document.getElementById("floating-music-player");
	var mgr = window.__fireflyMusic;
	if (!root || !mgr || root.hasAttribute("data-initialized")) return;
	root.setAttribute("data-initialized", "true");

	var ui = {
		loadingEntry: root.querySelector(".loading-entry"),
		orbEntry: root.querySelector(".orb-entry"),
		miniCover: root.querySelector(".mini-cover"),
		expandButtons: root.querySelectorAll(".expand-button"),
		hideButtons: root.querySelectorAll(".hide-button"),
		collapseButton: root.querySelector(".collapse-button"),
		coverImages: root.querySelectorAll(".cover-image"),
		coverButtons: root.querySelectorAll(".cover-button"),
		titles: root.querySelectorAll(".track-title"),
		artists: root.querySelectorAll(".track-artist"),
		playButton: root.querySelector(".play-button"),
		prevButton: root.querySelector(".prev-button"),
		nextButton: root.querySelector(".next-button"),
		modeButton: root.querySelector(".mode-button"),
		muteButton: root.querySelector(".mute-button"),
		lyricsButton: root.querySelector(".lyrics-button"),
		playlistButton: root.querySelector(".playlist-button"),
		progressControl: root.querySelector(".progress-control"),
		progressFill: root.querySelector(".progress-fill"),
		progressThumb: root.querySelector(".progress-thumb"),
		volumeControl: root.querySelector(".volume-control"),
		volumeFill: root.querySelector(".volume-fill"),
		volumeThumb: root.querySelector(".volume-thumb"),
		currentTime: root.querySelector(".current-time"),
		totalTime: root.querySelector(".total-time"),
		lyricsContainer: root.querySelector(".lyrics-container"),
		playlistContainer: root.querySelector(".playlist-container"),
	};

	var eventHandlers = [];
	var isUserScrolling = false;
	var scrollTimer = 0;
	var currentLyrics = [];
	var currentLrcIndex = -1;

	function setView(view) {
		root.dataset.view = view;
		if (view !== "expanded") setDrawer("none");
	}

	function setDrawer(drawer) {
		root.dataset.drawer = drawer;
		ui.lyricsButton.setAttribute("aria-pressed", String(drawer === "lyrics"));
		ui.playlistButton.setAttribute("aria-pressed", String(drawer === "playlist"));
	}

	function updatePlayState(isPlaying) {
		root.classList.toggle("is-playing", isPlaying);
		ui.coverButtons.forEach(function (button) {
			button.setAttribute("aria-label", isPlaying ? cfg.i18n.pause : cfg.i18n.play);
			button.title = isPlaying ? cfg.i18n.pause : cfg.i18n.play;
		});
		ui.playButton.setAttribute("aria-label", isPlaying ? cfg.i18n.pause : cfg.i18n.play);
		ui.playButton.title = isPlaying ? cfg.i18n.pause : cfg.i18n.play;
		updatePlaylistActive(mgr.getState().currentIndex);
	}

	function updateTrack(track) {
		if (!track) return;
		ui.titles.forEach(function (element) {
			element.textContent = track.name;
			element.title = track.name;
		});
		ui.artists.forEach(function (element) {
			element.textContent = track.artist;
			element.title = track.artist;
		});

		ui.coverImages.forEach(function (image) {
			if (track.pic) {
				image.hidden = false;
				image.src = track.pic;
				image.alt = track.name + " - " + track.artist;
			} else {
				image.hidden = true;
				image.removeAttribute("src");
				image.alt = cfg.i18n.noCover;
			}
		});
	}

	function updateTime(detail) {
		var progress = Math.max(0, Math.min(100, detail.progress || 0));
		ui.progressFill.style.width = progress + "%";
		ui.progressThumb.style.left = progress + "%";
		ui.progressControl.setAttribute("aria-valuenow", String(Math.round(progress)));
		ui.currentTime.textContent = detail.currentTimeStr || "0:00";
		ui.totalTime.textContent = detail.durationStr || "0:00";
	}

	function updateVolume(volume, isMuted) {
		var percent = isMuted ? 0 : Math.round(volume * 100);
		ui.volumeFill.style.width = percent + "%";
		ui.volumeThumb.style.left = percent + "%";
		ui.volumeControl.setAttribute("aria-valuenow", String(percent));
		root.classList.toggle("is-muted", isMuted || volume === 0);
	}

	function updateMode(playMode) {
		root.dataset.playMode = String(playMode);
		ui.modeButton.classList.toggle("is-active", playMode !== 0);
	}

	function renderPlaylist(playlist, currentIndex) {
		ui.playlistContainer.replaceChildren();
		var fragment = document.createDocumentFragment();
		playlist.forEach(function (track, index) {
			var button = document.createElement("button");
			button.type = "button";
			button.className = "floating-playlist-item";
			button.dataset.index = String(index);
			button.setAttribute("role", "option");
			button.setAttribute("aria-label", track.name + " - " + track.artist);
			button.addEventListener("click", function () { mgr.playTrackByIndex(index); });

			var cover = document.createElement("span");
			cover.className = "playlist-cover";
			if (track.pic) {
				var image = document.createElement("img");
				image.src = track.pic;
				image.alt = "";
				image.loading = "lazy";
				cover.appendChild(image);
			} else {
				cover.textContent = String(index + 1);
			}

			var metadata = document.createElement("span");
			metadata.className = "playlist-metadata";
			var title = document.createElement("strong");
			title.textContent = track.name;
			var artist = document.createElement("span");
			artist.textContent = track.artist;
			metadata.append(title, artist);
			button.append(cover, metadata);
			fragment.appendChild(button);
		});
		ui.playlistContainer.appendChild(fragment);
		updatePlaylistActive(currentIndex);
	}

	function updatePlaylistActive(currentIndex) {
		ui.playlistContainer.querySelectorAll(".floating-playlist-item").forEach(function (item) {
			var isActive = Number(item.dataset.index) === currentIndex;
			item.classList.toggle("is-active", isActive);
			item.setAttribute("aria-selected", String(isActive));
		});
	}

	function renderLyrics(lyrics, status) {
		currentLyrics = lyrics || [];
		currentLrcIndex = -1;
		ui.lyricsContainer.replaceChildren();
		if (status !== "loaded" || currentLyrics.length === 0) {
			var message = document.createElement("p");
			message.className = "drawer-status";
			message.textContent = status === "loading"
				? cfg.i18n.loadingLyrics
				: status === "failed"
					? cfg.i18n.failedLyrics
					: cfg.i18n.noLyrics;
			ui.lyricsContainer.appendChild(message);
			return;
		}

		var fragment = document.createDocumentFragment();
		currentLyrics.forEach(function (line, index) {
			var button = document.createElement("button");
			button.type = "button";
			button.className = "floating-lyric-line";
			button.dataset.index = String(index);
			button.setAttribute("role", "option");
			button.textContent = line.text;
			button.addEventListener("click", function () { mgr.seekToTime(line.time); });
			fragment.appendChild(button);
		});
		ui.lyricsContainer.appendChild(fragment);
	}

	function updateLyricIndex(index) {
		if (index === currentLrcIndex) return;
		currentLrcIndex = index;
		ui.lyricsContainer.querySelectorAll(".floating-lyric-line").forEach(function (line) {
			var isActive = Number(line.dataset.index) === index;
			line.classList.toggle("is-active", isActive);
			line.setAttribute("aria-selected", String(isActive));
		});
		if (!isUserScrolling && index >= 0) {
			var active = ui.lyricsContainer.querySelector('.floating-lyric-line[data-index="' + index + '"]');
			if (active) active.scrollIntoView({ block: "center", behavior: "smooth" });
		}
	}

	function syncAll() {
		var state = mgr.getState();
		if (!state.initialized) return;
		if (!state.playlist.length) {
			root.hidden = true;
			return;
		}
		root.hidden = false;
		setView("mini");
		renderPlaylist(state.playlist, state.currentIndex);
		updateTrack(state.track);
		updatePlayState(state.isPlaying);
		updateMode(state.playMode);
		updateVolume(state.volume, state.isMuted);
		updateTime(state);
		renderLyrics(state.lyrics, state.lyrics.length ? "loaded" : "none");
		updateLyricIndex(state.currentLrcIndex);
	}

	function on(name, handler) {
		window.addEventListener(name, handler);
		eventHandlers.push([name, handler]);
	}

	function updateRangeFromPointer(control, event, callback) {
		var rect = control.getBoundingClientRect();
		callback(Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width)));
	}

	function handleRangeKeyboard(event, currentValue, callback) {
		var next = currentValue;
		if (event.key === "ArrowLeft" || event.key === "ArrowDown") next -= 0.05;
		else if (event.key === "ArrowRight" || event.key === "ArrowUp") next += 0.05;
		else if (event.key === "Home") next = 0;
		else if (event.key === "End") next = 1;
		else return;
		event.preventDefault();
		callback(Math.max(0, Math.min(1, next)));
	}

	ui.orbEntry.addEventListener("click", function () { setView("mini"); });
	ui.expandButtons.forEach(function (button) {
		button.addEventListener("click", function () { setView("expanded"); });
	});
	ui.hideButtons.forEach(function (button) {
		button.addEventListener("click", function () { setView("orb"); });
	});
	ui.collapseButton.addEventListener("click", function () { setView("mini"); });
	ui.coverButtons.forEach(function (button) {
		button.addEventListener("click", function () { mgr.togglePlay(); });
	});
	ui.playButton.addEventListener("click", function () { mgr.togglePlay(); });
	ui.prevButton.addEventListener("click", function () { mgr.playPrev(); });
	ui.nextButton.addEventListener("click", function () { mgr.playNext(); });
	ui.modeButton.addEventListener("click", function () { mgr.cyclePlayMode(); });
	ui.muteButton.addEventListener("click", function () { mgr.toggleMute(); });
	ui.lyricsButton.addEventListener("click", function () {
		setDrawer(root.dataset.drawer === "lyrics" ? "none" : "lyrics");
	});
	ui.playlistButton.addEventListener("click", function () {
		setDrawer(root.dataset.drawer === "playlist" ? "none" : "playlist");
	});
	ui.progressControl.addEventListener("click", function (event) {
		updateRangeFromPointer(ui.progressControl, event, function (value) { mgr.seek(value); });
	});
	ui.volumeControl.addEventListener("click", function (event) {
		updateRangeFromPointer(ui.volumeControl, event, function (value) { mgr.setVolume(value); });
	});
	ui.progressControl.addEventListener("keydown", function (event) {
		handleRangeKeyboard(event, mgr.getState().progress / 100, function (value) { mgr.seek(value); });
	});
	ui.volumeControl.addEventListener("keydown", function (event) {
		handleRangeKeyboard(event, mgr.getState().volume, function (value) { mgr.setVolume(value); });
	});
	ui.lyricsContainer.addEventListener("scroll", function () {
		isUserScrolling = true;
		window.clearTimeout(scrollTimer);
		scrollTimer = window.setTimeout(function () { isUserScrolling = false; }, 2500);
	});
	ui.coverImages.forEach(function (image) {
		image.addEventListener("error", function () { image.hidden = true; });
	});

	on("fm:init", function (event) {
		if (!event.detail.playlist.length) {
			root.hidden = true;
			return;
		}
		syncAll();
	});
	on("fm:track", function (event) {
		updateTrack(event.detail.track);
		updatePlaylistActive(event.detail.index);
	});
	on("fm:play-state", function (event) { updatePlayState(event.detail.isPlaying); });
	on("fm:time", function (event) { updateTime(event.detail); });
	on("fm:volume", function (event) { updateVolume(event.detail.volume, event.detail.isMuted); });
	on("fm:mode", function (event) { updateMode(event.detail.playMode); });
	on("fm:lyrics", function (event) { renderLyrics(event.detail.lyrics, event.detail.status); });
	on("fm:lrc-index", function (event) { updateLyricIndex(event.detail.index); });
	on("fm:error", function () {
		if (!mgr.getState().playlist.length) root.hidden = true;
	});

	var cleaned = false;
	function cleanup() {
		if (cleaned) return;
		cleaned = true;
		eventHandlers.forEach(function (entry) { window.removeEventListener(entry[0], entry[1]); });
		window.clearTimeout(scrollTimer);
	}

	// The floating controls persist through Swup navigations. Clean up only when this
	// particular island leaves the DOM, otherwise it would stop receiving fm:* events.
	var observer = new MutationObserver(function (mutations) {
		for (var i = 0; i < mutations.length; i++) {
			var removedNodes = mutations[i].removedNodes;
			for (var j = 0; j < removedNodes.length; j++) {
				if (removedNodes[j] === root || (removedNodes[j].contains && removedNodes[j].contains(root))) {
					cleanup();
					observer.disconnect();
					return;
				}
			}
		}
	});
	if (root.parentNode) observer.observe(root.parentNode, { childList: true });

	var currentState = mgr.getState();
	if (currentState.initialized) syncAll();
	else mgr.init();
})();
</script>

<style>
	.floating-music-player {
		--entry-size: 3rem;
		--mini-width: min(17.5rem, calc(100vw - 1rem));
		--panel-width: min(20rem, calc(100vw - 1rem));
		position: relative;
		width: var(--entry-size);
		height: var(--entry-size);
		pointer-events: auto;
		transition: width 0.38s cubic-bezier(0.22, 1, 0.36, 1), height 0.38s cubic-bezier(0.22, 1, 0.36, 1);
		user-select: none;
	}

	.floating-music-player[hidden] {
		display: none;
	}

	.floating-music-player[data-view="mini"] {
		width: var(--mini-width);
		height: 4.5rem;
	}

	.floating-music-player[data-view="expanded"] {
		width: var(--panel-width);
		height: 14.5rem;
	}

	.floating-music-player[data-view="expanded"][data-drawer="lyrics"],
	.floating-music-player[data-view="expanded"][data-drawer="playlist"] {
		height: min(27rem, calc(100dvh - 10rem));
	}

	.floating-entry,
	.floating-panel {
		position: absolute;
		right: 0;
		bottom: 0;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.5rem) scale(0.96);
		transition: opacity 0.28s ease, transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.38s;
	}

	.floating-entry {
		width: var(--entry-size);
		height: var(--entry-size);
		border: 1px solid color-mix(in oklab, var(--primary) 32%, transparent);
		border-radius: 50%;
		background: var(--primary);
		color: white;
		box-shadow: 0 0.65rem 1.75rem color-mix(in oklab, var(--primary) 28%, transparent);
		display: grid;
		place-items: center;
		cursor: pointer;
	}

	.floating-entry:hover {
		transform: scale(1.06);
	}

	.loading-entry {
		cursor: wait;
	}

	.entry-icon {
